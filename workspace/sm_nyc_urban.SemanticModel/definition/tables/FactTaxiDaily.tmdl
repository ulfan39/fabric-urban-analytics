table FactTaxiDaily
	lineageTag: fa2ce029-ec22-4938-919a-d443dff55449
	sourceLineageTag: [gold].[FactTaxiDaily]

	measure 'Total Trips' = SUM ( FactTaxiDaily[Trips] )
		formatString: 0
		lineageTag: a4917e17-e206-427d-b521-7495434d66a4

		changedProperty = Name

	measure 'Revenue USD' = SUM ( FactTaxiDaily[TotalUsd] )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: a18d8dcd-adef-458f-9b2d-fc03a2f6ff2a

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Revenue EUR' = SUM ( FactTaxiDaily[TotalEur] )
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
		lineageTag: 7ea75599-38d5-4a08-88f2-91859a121144

		changedProperty = FormatString

	measure 'Revenue per Trip USD' = DIVIDE ( [Revenue USD], [Total Trips] )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: ca0e14de-c86a-431e-9b5d-52bdbbd6f7b7

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Revenue per Trip EUR' = DIVIDE ( [Revenue EUR], [Total Trips] )
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
		lineageTag: 92652690-49fa-45a2-a210-4892729504b6

		changedProperty = FormatString

	measure 'Avg Fare USD' = DIVIDE ( SUM ( FactTaxiDaily[FareUsd] ), [Total Trips] )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: ef7d5d3a-66b9-4610-ae08-20feb9fd983b

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Avg Duration min' = DIVIDE ( SUM ( FactTaxiDaily[DurationMin] ), [Total Trips] )
		lineageTag: 457c318c-1b59-47fc-bdfc-912ce40cf63a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Trips per Day' = DIVIDE ( [Total Trips], DISTINCTCOUNT ( FactTaxiDaily[DateKey] ) )
		lineageTag: 4ce992e8-23a9-4213-aaf9-177e6f2d69eb

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Corr Trips PM2.5' = ```
			
			        VAR T = FILTER ( ADDCOLUMNS ( VALUES ( DimDate[Date] ), "x", [Total Trips], "y", [PM2.5] ),
			                         NOT ISBLANK ( [x] ) && NOT ISBLANK ( [y] ) )
			        VAR mx = AVERAGEX ( T, [x] )
			        VAR my = AVERAGEX ( T, [y] )
			        RETURN DIVIDE ( SUMX ( T, ( [x] - mx ) * ( [y] - my ) ),
			                        SQRT ( SUMX ( T, ( [x] - mx ) ^ 2 ) * SUMX ( T, ( [y] - my ) ^ 2 ) ) )
			```
		formatString: #,0.00
		lineageTag: 3a8eac17-3dd7-4a49-a267-5080ba31af41

		changedProperty = FormatString

	measure 'Corr Trips NO2' = ```
			
			        VAR T = FILTER ( ADDCOLUMNS ( VALUES ( DimDate[Date] ), "x", [Total Trips], "y", [NO2] ),
			                         NOT ISBLANK ( [x] ) && NOT ISBLANK ( [y] ) )
			        VAR mx = AVERAGEX ( T, [x] )
			        VAR my = AVERAGEX ( T, [y] )
			        RETURN DIVIDE ( SUMX ( T, ( [x] - mx ) * ( [y] - my ) ),
			                        SQRT ( SUMX ( T, ( [x] - mx ) ^ 2 ) * SUMX ( T, ( [y] - my ) ^ 2 ) ) )
			```
		formatString: #,0.00
		lineageTag: e649fb32-ad30-48c4-afb8-0dc0db458c37

		changedProperty = FormatString

