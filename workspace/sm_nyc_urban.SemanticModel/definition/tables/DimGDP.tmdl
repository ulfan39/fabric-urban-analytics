table DimGDP
	lineageTag: 2a8e9906-5254-44a6-835c-b448012e4125
	sourceLineageTag: [gold].[DimGDP]

	measure 'US GDP USD' = CALCULATE ( SUM ( DimGDP[GdpUsd] ), DimGDP[CountryCode] = "USA", TREATAS ( VALUES ( DimDate[Year] ), DimGDP[Year] ) )
